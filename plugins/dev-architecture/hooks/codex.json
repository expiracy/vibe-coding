{
  "hooks": {
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${PLUGIN_ROOT}/hooks/skill_context.py\"",
            "timeout": 5,
            "additionalContextLimit": 4096,
            "statusMessage": "Loading relevant skill context"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "^(Read|Edit|Write|MultiEdit|Bash|apply_patch|exec_command|shell_command|read_file|write_file|edit_file|mcp__.*)$",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${PLUGIN_ROOT}/hooks/skill_context.py\"",
            "timeout": 5,
            "additionalContextLimit": 4096,
            "statusMessage": "Loading relevant skill context"
          }
        ]
      }
    ],
    "PreCompact": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${PLUGIN_ROOT}/hooks/skill_context.py\"",
            "timeout": 5,
            "statusMessage": "Loading relevant skill context"
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "matcher": "^(startup|resume|clear|compact|fork)$",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${PLUGIN_ROOT}/hooks/skill_context.py\"",
            "timeout": 5,
            "additionalContextLimit": 4096,
            "statusMessage": "Loading relevant skill context"
          }
        ]
      }
    ]
  }
}
